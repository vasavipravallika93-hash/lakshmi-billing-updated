# Copy this file to .env for local development, and set the same
# values in Vercel > Project Settings > Environment Variables
# for production. There is only ONE user for this app.

VITE_OWNER_EMAIL=owner@lakshmienginerring.com
VITE_OWNER_PASSWORD=change-this-password

# Supabase — stores Customers and Products (see supabase/SETUP.md).
# Find these in your Supabase project: Settings > API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
